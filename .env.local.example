# Supabase — copy to .env.local for local development and set the same keys in Vercel project settings.

# Safe for browser / client components (NEXT_PUBLIC_* is exposed to the bundle).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: seed scripts, migrations tooling, admin tasks. Never import into client components.
SUPABASE_SERVICE_ROLE_KEY=
